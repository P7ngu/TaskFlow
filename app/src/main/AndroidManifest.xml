<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Permesso per inviare notifiche — obbligatorio da Android 13 (API 33).
     Senza questo, le notifiche non vengono mostrate anche se create. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Permesso per programmare allarmi esatti — obbligatorio da Android 12 (API 31).
         Serve per i reminder precisi (es. notifica all'ora esatta della scadenza).
         Se non dichiarato, AlarmManager.setExact() viene ignorato silenziosamente. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Permesso in lettura del calendario di sistema.
         Permette di leggere eventi esistenti per evitare sovrapposizioni. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Permesso in scrittura del calendario di sistema.
         Permette di aggiungere il task come evento nel calendario dell'utente. -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:name=".TaskFlowApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TaskFlow">

        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            android:theme="@style/Theme.TaskFlow">
            <!--
         windowSoftInputMode="adjustResize": dice ad Android di
         ridimensionare il layout quando la tastiera virtuale appare.

         Senza questo attributo, il comportamento predefinito è
         "adjustPan" — Android sposta la finestra verso l'alto senza
         ridimensionarla. Il risultato è che il contenuto in basso
         sparisce sotto la tastiera e non è raggiungibile.

         Con "adjustResize", il sistema riduce l'altezza disponibile
         per il layout — Compose lo sa e può calcolare correttamente
         lo spazio rimasto. verticalScroll e imePadding possono
         quindi fare il loro lavoro.
    -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            WorkManager richiede questo provider nel Manifest.
            tools:node="remove": rimuove il provider di default di WorkManager
            perché usiamo la nostra configurazione custom con Hilt.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
